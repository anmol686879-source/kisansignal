# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
# Long random string (openssl rand -hex 32). Signs OTP hashes.
OTP_SECRET=
# SMS provider: twilio (production) or console (local development only)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, e.g. +1555...
TWILIO_FROM=
# Use instead of TWILIO_FROM if you have a messaging service:
# TWILIO_MESSAGING_SERVICE_SID=
# true when behind a proxy/load balancer (Render, Fly, nginx) so rate limits see real IPs
TRUST_PROXY=true
PORT=8080
# Set DATABASE_URL to a PostgreSQL connection string to use hosted PostgreSQL.
# When unset, the server uses the local SQLite file below.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_FILE=./data/kisansignal.db
